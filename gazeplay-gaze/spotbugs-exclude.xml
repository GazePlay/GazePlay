<FindBugsFilter>
    <!-- Same general rules as the other modules -->
    <Match>
        <Source name="~.*" />
        <Bug code="RV,UMAC,SING,CT,AT,US,FS"/>
    </Match>
    <Match>
        <Package name="~.*"/>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2,THROWS_METHOD_THROWS_RUNTIMEEXCEPTION,THROWS_METHOD_THROWS_CLAUSE_BASIC_EXCEPTION"/>
    </Match>
    <!-- Exact comparison with the sentinel value returned by the Tobii wrapper without gaze data (anomaly R9) -->
    <Match>
        <Class name="net.gazeplay.commons.gaze.devicemanager.PositionPollerRunnable"/>
        <Method name="nextGazePoint"/>
        <Bug pattern="FE_FLOATING_POINT_EQUALITY"/>
    </Match>
</FindBugsFilter>
