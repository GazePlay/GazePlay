; GazePlay Learning Inno Setup Skeleton Script
;
; PLEASE NOTE:
;
; 1. This script is a SKELETON and is meant to be parsed by the Gradle 
;    task "innosetup" before handing it to the Inno Setup compiler (ISCC)
;
; 2. All VARIABLES with a dollar sign and curly brackets are replaced
;    by Gradle, e.g. "applicationVersion" below
;
; 3. The script is COPIED to build/innosetup before its run,
;    so all relative paths refer to this path!
;
; 4. All BACKSLASHES must be escaped 
;

[Setup]
; Not "GazePlay": GazePlay Learning is installed next to a former GazePlay, which is left as it is
AppId=GazePlayLearning
AppName=GazePlay Learning
AppVersion=${applicationVersion}
AppVerName=GazePlay Learning ${applicationVersion}
AppPublisher=Univ. Grenoble Alpes - LIG - GETALP
AppPublisherURL=https://github.com/GazePlay/GazePlay
AppSupportURL=https://github.com/GazePlay/GazePlay/issues
AppUpdatesURL=https://github.com/GazePlay/GazePlay/releases

SetupIconFile=gazeplayicon.ico
WizardStyle=modern
WizardImageFile=gazeplayicon.bmp
WizardSmallImageFile=gazeplayicon.bmp

DefaultDirName={commonpf}\\GazePlay Learning
DefaultGroupName=GazePlay Learning
LicenseFile=licence.txt

OutputDir=..\\distributions
OutputBaseFilename=${distributionName}-windows-x64-${applicationVersion}-installer
;Compression=lzma
SolidCompression=yes

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"

[Files]
Source: "gazeplayicon.ico"; DestDir: "{app}\\bin"; Flags: ignoreversion
Source: "..\\${unpackedDirectory}\\bin\\*"; DestDir: "{app}\\bin"; Flags: ignoreversion
Source: "..\\${unpackedDirectory}\\lib\\*"; DestDir: "{app}\\lib"; Flags: ignoreversion recursesubdirs createallsubdirs
Source: "..\\${unpackedDirectory}\\dependency-license\\*"; DestDir: "{app}\\license"; Flags: ignoreversion recursesubdirs createallsubdirs
; NOTE: Don't use "Flags: ignoreversion" on any shared system files

[Icons]
Name: "{group}\\GazePlay Learning"; Filename: "{app}\\bin\\gazeplay-learning-windows.bat"; IconFilename: "{app}\\bin\\gazeplayicon.ico"; Flags: runminimized
Name: "{group}\\Uninstall GazePlay Learning"; Filename: "{uninstallexe}"; IconFilename: "{app}\\bin\\gazeplayicon.ico"
Name: "{commondesktop}\\GazePlay Learning"; Filename: "{app}\\bin\\gazeplay-learning-windows.bat"; Tasks: desktopicon; IconFilename: "{app}\\bin\\gazeplayicon.ico"

[Run]
Filename: "{app}\\bin\\gazeplay-learning-windows.bat"; Description: "{cm:LaunchProgram,GazePlay Learning}"; Flags: shellexec postinstall skipifsilent

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"
Name: "french"; MessagesFile: "compiler:Languages\\French.isl"

[CustomMessages]
english.UninstallFormerGazePlay=GazePlay, the former version of GazePlay Learning, is installed on this computer.%n%nDo you want to uninstall it first? Its data (profiles, settings, results) are kept: GazePlay Learning uses them.%n%nIf you answer No, both are installed side by side.
french.UninstallFormerGazePlay=GazePlay, l'ancienne version de GazePlay Learning, est installé sur cet ordinateur.%n%nVoulez-vous d'abord le désinstaller ? Ses données (profils, réglages, résultats) sont gardées : GazePlay Learning les utilise.%n%nSi vous répondez Non, les deux seront installés côte à côte.
english.UninstallOlderGazePlayLearning=An older version of GazePlay Learning was detected. Do you want to uninstall it?
french.UninstallOlderGazePlayLearning=Une version précédente de GazePlay Learning est installée. Voulez-vous la désinstaller ?

[Code]
const
  UninstallKeys = 'Software\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\';

{ Uninstall command of an application installed by Inno Setup, for all users (32 or 64 bits view) or the current
  user, or '' if it is not installed }
function FindUninstallString(const AppId: String): String;
var
  Key: String;
begin
  Result := '';
  Key := UninstallKeys + AppId + '_is1';
  if RegQueryStringValue(HKLM, Key, 'UninstallString', Result) then
    Exit;
  if IsWin64 and RegQueryStringValue(HKLM64, Key, 'UninstallString', Result) then
    Exit;
  if RegQueryStringValue(HKCU, Key, 'UninstallString', Result) then
    Exit;
  Result := '';
end;

{ Runs an uninstaller and waits for its end }
procedure RunUninstaller(const UninstallString: String);
var
  ResultCode: Integer;
begin
  Exec(RemoveQuotes(UninstallString), '', '', SW_SHOW, ewWaitUntilTerminated, ResultCode);
end;

function InitializeSetup: Boolean;
var
  UninstallString: String;
begin
  Result := True;

  { Former GazePlay (AppId GazePlay): optional, GazePlay Learning can be installed next to it }
  UninstallString := FindUninstallString('GazePlay');
  if UninstallString <> '' then
  begin
    if MsgBox(CustomMessage('UninstallFormerGazePlay'), mbConfirmation, MB_YESNO) = IDYES then
      RunUninstaller(UninstallString);
  end;

  { Older GazePlay Learning: uninstalled first, as before; the installation stops if it is kept }
  UninstallString := FindUninstallString('GazePlayLearning');
  if UninstallString <> '' then
  begin
    if MsgBox(CustomMessage('UninstallOlderGazePlayLearning'), mbConfirmation, MB_YESNO) = IDYES then
      RunUninstaller(UninstallString)
    else
      Result := False;
  end;
end;
